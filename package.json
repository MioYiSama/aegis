{
  "name": "aegis-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run wasm:build && vite --host",
    "wasm:build": "wasm-pack build crates/wasm --target web --out-dir ../../src/wasm/generated --out-name aegis_wasm --release",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:generate": "orval --config orval.config.ts",
    "typecheck": "tsc -b",
    "build": "npm run wasm:build && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/dm-sans": "latest",
    "@phosphor-icons/react": "latest",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "orval": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wasm-pack": "0.15.0"
  },
  "engines": {
    "node": ">=22.22"
  },
  "allowScripts": {
    "wasm-pack@0.15.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
